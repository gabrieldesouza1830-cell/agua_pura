<body>
  
  <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo principal</a>
  <header class="cabecalho"><div class="container cabecalho-interno">
    <a class="marca" href="index.html" aria-label="Água Pura — página inicial"><img src="img/agua-pura-logo.svg" alt="" width="45" height="45"><span>Água <strong>Pura</strong><small>Água, vida e dignidade</small></span></a>
    <nav class="menu-principal" aria-label="Navegação principal"><a href="index.html">Início</a><a href="sobre.html">Sobre</a><a href="projetos.html" aria-current="page">Projetos</a><a class="link-destaque" href="contato.html">Participe</a></nav>
